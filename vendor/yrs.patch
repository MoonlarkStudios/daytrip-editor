+    // Daytrip regression: compare cached lengths with a fresh count after every
+    // valid Unicode split and squash. Byte indexing must keep its old behavior.
+    #[test]
+    fn cached_item_lengths_survive_unicode_splits_and_squashes() {
+        use crate::block::{ClientID, Item, ItemContent, ItemPtr, ID};
+        use crate::types::TypePtr;
+
+        let source = "a日本e\u{301}🧑‍💻שלום\r\nlast";
+        let make = |content| {
+            Item::new(
+                ID::new(ClientID::new(1), 0),
+                None,
+                None,
+                None,
+                None,
+                TypePtr::Named("text".into()),
+                None,
+                content,
+            )
+            .unwrap()
+        };
+        let check = |item: &Item| {
+            for kind in [OffsetKind::Utf16, OffsetKind::Bytes] {
+                assert_eq!(item.content_len(kind), item.content.len(kind));
+            }
+        };
+        let mut offset = 0;
+        for scalar in source.chars().take(source.chars().count() - 1) {
+            offset += scalar.len_utf16() as u32;
+            let mut left = make(ItemContent::String(source.into()));
+            let mut ptr = ItemPtr::from(&mut left);
+            let mut right = ptr.splice(offset, OffsetKind::Utf16).unwrap();
+            check(&left);
+            check(&right);
+            assert!(ptr.try_squash(ItemPtr::from(&mut right)));
+            check(&left);
+            assert_eq!(
+                left.content_len(OffsetKind::Utf16),
+                source.encode_utf16().count() as u32
+            );
+        }
+        // Non-text and non-countable items still use the same logical length.
+        for content in [
+            ItemContent::Deleted(7),
+            ItemContent::Any(vec![crate::Any::Null; 3]),
+            ItemContent::JSON(vec!["a".into(), "b".into()]),
+            ItemContent::Binary(vec![1, 2, 3]),
+            ItemContent::Format("bold".into(), Box::new(crate::Any::Bool(true))),
+        ] {
+            check(&make(content));
+        }
+    }
